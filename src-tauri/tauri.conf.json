{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "accuCountFM",
  "version": "0.1.0",
  "identifier": "com.doctorks.accucountfm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "accuCountFM",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "DoctorKS",
    "category": "Productivity",
    "shortDescription": "คำนวณเงินเวรแพทย์นิติเวช",
    "longDescription": "แอปคำนวณเงินเวรแพทย์นิติเวช 4 คน รองรับ OCR ตารางเวรและ export Excel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": "powershell.exe -ExecutionPolicy Bypass -File ../tools/sign.ps1 -File \"%1\""
    }
  },
  "plugins": {
    "sql": {
      "preload": []
    }
  }
}
